# Server
PORT=3000

# Database (samakan dengan koneksi.php)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_umkm_festival
DB_USER=root
DB_PASS=

# Harus sama dengan CHATBOT_SHARED_SECRET di chatbot-config.php
CHATBOT_SHARED_SECRET=ccf-chatbot-dev-secret-change-me

# URL publik aplikasi PHP (tanpa trailing slash)
APP_BASE_URL=http://localhost/cireboncreativefestival2026

# Origin frontend yang boleh mengakses service ini.
# Pisahkan dengan koma, atau gunakan * untuk development.
CORS_ORIGIN=http://localhost,http://127.0.0.1

# Batas pesan
CHAT_MAX_MESSAGE_LENGTH=500
CHAT_RATE_LIMIT=30
CHAT_RATE_WINDOW=60

# Provider AI opsional (dikonfigurasi dari admin/chatbot-config.php)
AI_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=512
